# Gemini API Key (get free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Google Sheets Configuration
# Path to service account credentials JSON (default: creds.json in root)
GOOGLE_APPLICATION_CREDENTIALS=creds.json
# Name or ID of the Google Sheet (optional, will create or use 'Job Applications Tracker' if empty)
GOOGLE_SHEET_NAME=Job Applications Tracker

# Web Server Port
PORT=5000
